msgstr ""

msgid "문자 (기본 폰트 - 한/영/중/일 지원)를 표시합니다."
msgstr "Displays text (default font - supports Korean/English/Chinese/Japanese)."

msgid "이미지 파일를 그립니다."
msgstr "Draws an image file."

msgid "이미지 데이터(cv2)를 그립니다."
msgstr "Draws image data (cv2)."

