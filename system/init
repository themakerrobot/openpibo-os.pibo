# network init
echo "START - booting.py"
#/etc/systemd/system/booting.service
sudo systemctl start booting.service

# run server
echo "START - run_ide.py"
#/etc/systemd/system/ide.service
sudo systemctl start ide.service

# --- 설정 ---
# 확인할 패키지 이름
PACKAGE_NAME="openpibo-python"
# 실행을 허용할 목표 버전
TARGET_VERSION="0.9.3.4"
# 사용할 Python 및 pip 경로 (pyenv 환경에 맞게)
PYTHON_PATH="/home/pi/.pyenv/bin/python3"
PIP_PATH="/home/pi/.pyenv/bin/pip3"

# --- 스크립트 시작 ---
echo "Checking version of '$PACKAGE_NAME'..."

# pip show 명령으로 현재 설치된 패키지 버전을 가져오고, 좌우 공백을 제거합니다.
# 패키지가 설치되지 않은 경우를 대비해 || true를 추가하여 -e 옵션으로 스크립트가 중단되지 않게 합니다.
CURRENT_VERSION=$($PIP_PATH show "$PACKAGE_NAME" 2>/dev/null | grep "Version:" | awk '{print $2}' | xargs) || true

# 버전 비교
if [ "$CURRENT_VERSION" = "$TARGET_VERSION" ]; then
    echo "Version is $CURRENT_VERSION. Starting AI core..."
    
    # run ai core
    cd /home/pi/openpibo-os/ai_core
    sudo $PYTHON_PATH run_ai_core.py &
    
    echo "AI core started in the background."
else
    echo "Version check failed. Required version: $TARGET_VERSION, but found: '$CURRENT_VERSION'."
    echo "AI core will not start."
    # 스크립트가 성공적으로 '아무것도 하지 않음'을 나타내기 위해 성공 코드로 종료합니다.
fi
